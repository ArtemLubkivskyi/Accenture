# Azure OpenAI credentials shared by the bootcamp notebooks.
# Copy this file to `.env` in the same folder as the notebooks (on Google Colab: upload it
# with the Files panel) and fill in your values.
# Keep `.env` private (never commit or share it).

# Your Azure OpenAI API key
AZURE_OPENAI_API_KEY=api-key-here

# Your Azure OpenAI base URL, e.g. https://<resource>.openai.azure.com/ (or .../openai/v1/)
AZURE_OPENAI_ENDPOINT=endpoint-here

# Deployment (model) name: gpt-5.4-mini or gpt-5.6-luna
AZURE_OPENAI_DEPLOYMENT=model-name-here

# Optional: LangSmith tracing for the LangGraph notebook.
# Uncomment and set your key to enable tracing (leave commented out to disable it).
# LANGSMITH_API_KEY=your-langsmith-api-key

# Optional: only if your LangSmith organization is hosted in the EU (eu.smith.langchain.com), also uncomment:
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
